<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Meu_controle" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/receita_fundo</item>
        <item name="colorOnPrimaryContainer">@color/receita_texto</item>
        <item name="colorSecondary">@color/primary_green</item>
        <item name="colorError">@color/acao_excluir</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOutline">@color/field_stroke</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Todo MaterialButton usa esse estilo sem precisar repetir no layout -->
        <item name="materialButtonStyle">@style/Widget.MeuControle.Button</item>
    </style>

    <style name="Widget.MeuControle.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Theme.Meu_controle" parent="Base.Theme.Meu_controle" />
</resources>