<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottom_nav_container"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Espaço Ativo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_border"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginBottom="24dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESPAÇO ATIVO"
                        android:textColor="#777777"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/active_space_name_cal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meu espaço individual"
                        android:textColor="#333333"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <TextView
                    android:id="@+id/active_space_detail_cal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_green"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:text="Privado"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Cabeçalho do mês -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/btn_mes_anterior"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;"
                    android:textSize="24sp"
                    android:padding="8dp" />
                <TextView
                    android:id="@+id/titulo_mes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mês"
                    android:textAlignment="center"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/btn_mes_proximo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&gt;"
                    android:textSize="24sp"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Grade do calendário -->
            <GridLayout
                android:id="@+id/grade_calendario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_border"
                android:columnCount="7"
                android:padding="8dp"
                android:layout_marginBottom="24dp" />

            <!-- Dia selecionado -->
            <TextView
                android:id="@+id/rotulo_data_selecionada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Movimentações"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/banner_feriado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/status_pending_background"
                android:textColor="@color/status_pending_text"
                android:textStyle="bold"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/aviso_dia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Atenção: este não é um dia útil. Vencimentos podem ser compensados no próximo dia útil."
                android:textColor="@color/status_pending_text"
                android:textSize="12sp"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_movimentacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/reminders_title"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/container_lembretes_dia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/msg_sem_lembretes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/calendar_no_reminders"
                android:textAlignment="center"
                android:textColor="#777777" />

            <TextView
                android:id="@+id/msg_sem_movimentacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nenhuma movimentação nesta data"
                android:textAlignment="center"
                android:textColor="#777777"
                android:layout_marginBottom="24dp" />

            <!-- Feriados do mês -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Feriados do mês"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/container_feriados_mes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calendar_open_reminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:text="@string/calendar_open_reminders"
                android:textAllCaps="false" />

            <!-- Origem dos dados da API -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EBF5EC"
                android:padding="16dp"
                android:orientation="horizontal">
                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#2E7D32"
                    android:layout_marginEnd="12dp" />
                <TextView
                    android:id="@+id/status_api"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carregando feriados..."
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_nav_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <include layout="@layout/layout_bottom_nav" />
    </LinearLayout>
</RelativeLayout>